@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<button type="button"
        class="theme-toggle"
        role="switch"
        aria-checked="@(IsDark ? "true" : "false")"
        title="@(IsDark ? "Switch to light mode" : "Switch to dark mode")"
        aria-label="@(IsDark ? "Switch to light mode" : "Switch to dark mode")"
        @onclick="Toggle">
    <span class="theme-toggle__track">
        <span class="theme-toggle__track-icon theme-toggle__track-icon--sun" aria-hidden="true">☀️</span>
        <span class="theme-toggle__track-icon theme-toggle__track-icon--moon" aria-hidden="true">🌙</span>
        <span class="theme-toggle__thumb"></span>
    </span>
</button>

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<ThemeToggle>? _dotNetRef;
    private bool IsDark { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./js/theme.js");
            var current = await _module.InvokeAsync<string>("getTheme");
            IsDark = current == "dark";

            // This component is mounted twice (BioHeader + SectionNav) —
            // registering here means a toggle from *either* instance
            // calls OnThemeChanged on both, so they can't fall out of
            // sync with each other.
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("onThemeChange", _dotNetRef);

            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnThemeChanged(string theme)
    {
        IsDark = theme == "dark";
        StateHasChanged();
    }

    private async Task Toggle()
    {
        if (_module is null)
        {
            return;
        }

        // Don't set IsDark from the return value here — setTheme's
        // notifyListeners call already invokes OnThemeChanged on this
        // instance (and every other mounted one) once the theme lands.
        await _module.InvokeVoidAsync("toggleTheme");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                if (_dotNetRef is not null)
                {
                    await _module.InvokeVoidAsync("offThemeChange", _dotNetRef);
                }
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to clean up.
            }
        }

        _dotNetRef?.Dispose();
    }
}
