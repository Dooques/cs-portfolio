@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<button type="button"
        class="theme-toggle"
        title="@(IsDark ? "Switch to light mode" : "Switch to dark mode")"
        aria-label="@(IsDark ? "Switch to light mode" : "Switch to dark mode")"
        @onclick="Toggle">
    @if (ShowLabel)
    {
        <span class="theme-toggle__label">
            Click here for @(IsDark ? "light" : "dark") mode
        </span>
    }
    @(IsDark ? "☀️" : "🌙")
</button>

@code {
    [Parameter] public bool ShowLabel { get; set; }

    private IJSObjectReference? _module;
    private bool IsDark { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./js/theme.js");
            var current = await _module.InvokeAsync<string>("getTheme");
            IsDark = current == "dark";
            StateHasChanged();
        }
    }

    private async Task Toggle()
    {
        if (_module is null)
        {
            return;
        }

        var next = await _module.InvokeAsync<string>("toggleTheme");
        IsDark = next == "dark";
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to clean up.
            }
        }
    }
}
