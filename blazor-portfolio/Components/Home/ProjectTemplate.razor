@using blazor_portfolio.Model
<div class="project-showcase @(Reversed ? "project-showcase--reverse" : "")">
    <div class="project-showcase__details">
        <Heading3>
            @if (!string.IsNullOrWhiteSpace(Project.Url))
            {
                <a href="@Project.Url" target="_blank" rel="noopener noreferrer" class="project-showcase__title-link">
                    @Project.Title
                </a>
            }
            else
            {
                @Project.Title
            }
        </Heading3>

        <Paragraph>
            @Project.Description
        </Paragraph>

        <Heading4>
            Tech Stack
        </Heading4>

        <ul class="project-showcase__tags">
            @foreach (var tech in Project.TechStack)
            {
                <li>@tech</li>
            }
        </ul>
    </div>

    <div class="project-showcase__media" @key="Project.Title">
        <Carousel @bind-SelectedSlide="SelectedSlide"
                  Autoplay="false">
            @if (Project.Images.Any())
            {
                var i = 0;
                foreach (var imageUrl in Project.Images)
                {
                    var index = i.ToString();
                    <CarouselSlide Name="@index">
                        <img src="@imageUrl" alt="@Project.Title" class="project-showcase__image"/>
                    </CarouselSlide>
                    i++;
                }
            }
        </Carousel>
    </div>
</div>

@code {
    [Parameter] public Project Project { get; set; } = new();
    [Parameter] public bool Reversed { get; set; }

    private string SelectedSlide { get; set; } = "0";

    protected override void OnParametersSet()
    {
        SelectedSlide = "0";
    }

}
