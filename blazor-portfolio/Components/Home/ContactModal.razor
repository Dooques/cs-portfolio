@using System.ComponentModel.DataAnnotations
@inject IJSRuntime JsRuntime

<Modal @ref="_modal">
    <ModalContent Centered="true" Class="contact-modal__content">
        <ModalHeader Class="contact-modal__header">
            <ModalTitle Class="contact-modal__title">Get in Touch</ModalTitle>
            <CloseButton/>
        </ModalHeader>
        <ModalBody Class="contact-modal__body">
            <EditForm Model="@FormModel" OnValidSubmit="@HandleSubmit" class="contact-form">
                <DataAnnotationsValidator/>

                <div class="contact-form__row">
                    <div class="contact-form__field">
                        <label for="contact-name">Name</label>
                        <InputText id="contact-name" class="contact-form__input" @bind-Value="FormModel.Name"/>
                        <ValidationMessage For="@(() => FormModel.Name)"/>
                    </div>

                    <div class="contact-form__field">
                        <label for="contact-email">Email</label>
                        <InputText id="contact-email" class="contact-form__input" @bind-Value="FormModel.Email"/>
                        <ValidationMessage For="@(() => FormModel.Email)"/>
                    </div>
                </div>

                <div class="contact-form__field">
                    <label for="contact-message">Message</label>
                    <InputTextArea id="contact-message" class="contact-form__input" Rows="4" @bind-Value="FormModel.Message"/>
                    <ValidationMessage For="@(() => FormModel.Message)"/>
                </div>

                <button type="submit" class="btn-accent">Send</button>
            </EditForm>
        </ModalBody>
    </ModalContent>
</Modal>

@code {
    private Modal _modal = null!;
    private ContactFormModel FormModel { get; set; } = new();

    public Task Open() => _modal.Show();

    // No backend email service is wired up, so this opens the visitor's own
    // mail client with the message pre-filled, rather than pretending to
    // deliver it silently. Swap for a real POST once there's somewhere to
    // send it to.
    private async Task HandleSubmit()
    {
        var subject = Uri.EscapeDataString($"Portfolio contact from {FormModel.Name}");
        var body = Uri.EscapeDataString($"{FormModel.Message}\n\nFrom: {FormModel.Name} ({FormModel.Email})");
        var mailto = $"mailto:samuel@dooques.uk?subject={subject}&body={body}";
        await JsRuntime.InvokeVoidAsync("open", mailto, "_self");
        await _modal.Hide();
        FormModel = new();
    }

    private class ContactFormModel
    {
        [Required]
        public string Name { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Message { get; set; } = "";
    }
}
