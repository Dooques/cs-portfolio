<section class="contact" id="contact">
    <h2 class="contact__heading">Contact</h2>

    <p class="contact__intro">
        Like what you see and want to get in touch with me? Click one of my socials, or
        send me an email.
    </p>

    <div class="contact__layout">
        <ul class="contact-socials">
            <li class="contact-socials__item">
                <a href="https://linkedin.com/in/dooques">
                    <img src="img/linkedin.png" alt="LinkedIn"/>
                    <span>LinkedIn</span>
                </a>
            </li>
            <li class="contact-socials__item">
                <a href="https://github.com/dooques">
                    <img src="img/github.png" alt="GitHub"/>
                    <span>GitHub</span>
                </a>
            </li>
            <li class="contact-socials__item">
                <a href="https://discord.com/users/638814970548715530">
                    <img src="img/discord.svg" alt="Discord"/>
                    <span>Discord</span>
                </a>
            </li>
            <li class="contact-socials__item">
                <button type="button" @onclick="() => _contactModal.Open()">
                    <img src="img/email.png" alt="Email"/>
                    <span>Email</span>
                </button>
            </li>
        </ul>
    </div>
</section>

<ContactModal @ref="_contactModal"/>

@code {
    private ContactModal _contactModal = null!;
}
