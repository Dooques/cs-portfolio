@using blazor_portfolio.Components.Pages
<Blazorise.ThemeProvider Theme="@_theme">
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)"/>
            <FocusOnNavigate RouteData="routeData" Selector="h1"/>
        </Found>
        
        <NotFound>
            <LayoutView>
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</Blazorise.ThemeProvider>


@code {

    // Same source as the --color-* tokens in app.css: sampled directly
    // from img/sam.png's illustration palette, so Blazorise-rendered
    // components (Carousel, Modal, etc.) and the rest of the page draw
    // from one consistent set of colors instead of two approximations.
    private readonly Theme _theme = new Theme
    {
        ColorOptions = new ThemeColorOptions
        {
            Primary = "#8F174D",   // burgundy shirt stripe
            Secondary = "#B56B3E", // warm auburn highlights
            Info = "#91A4F2",      // periwinkle background
            Dark = "#241820",      // deep plum outline
            Light = "#F2E2B7"      // cream skin tone
        },
        BackgroundOptions = new ThemeBackgroundOptions
        {
            Primary = "#8F174D",   // burgundy shirt stripe
            Secondary = "#B56B3E", // warm auburn highlights
            Info = "#91A4F2",      // periwinkle background
            Dark = "#241820",      // deep plum outline
            Light = "#F2E2B7"
        },
        TextColorOptions = new ThemeTextColorOptions
        {
            Primary = "#8F174D",   // burgundy shirt stripe
            Secondary = "#B56B3E", // warm auburn highlights
            Info = "#91A4F2",      // periwinkle background
            Dark = "#241820",      // deep plum outline
            Light = "#F2E2B7"
        }
    };
}